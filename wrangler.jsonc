{
  "name": "niki-world",
  "main": "cloudflare-worker.js",
  "account_id": "1eed1d5df5141a213c3b400caf572239",
  "compatibility_date": "2026-09-10",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/assets/media/videos/*"],
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "niki.ing", "custom_domain": true }
  ]
}
